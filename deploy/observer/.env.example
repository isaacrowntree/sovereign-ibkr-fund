# Where stream-health alerts go. WITHOUT this the observer still runs and still
# detects a dead feed — it just logs "no notifier configured" and the alert goes
# nowhere, which is indistinguishable from a healthy stream. That is not
# hypothetical: the event feed died on 2026-08-08 and nobody found out for four
# days, partly because nothing was scheduled to look and partly because what did
# look had no way to tell anyone.
IBKR_FUND_ALERT_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Labels the alert footer with the right book. paper | live
TRADING_MODE=paper
