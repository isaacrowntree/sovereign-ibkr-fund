# Copy to .env on the Pi and chmod 600.
#
# Required
IBKR_USERNAME=your_ibkr_username
IBKR_PASSWORD=your_ibkr_password

# Optional — defaults shown
# BEZANT_HEALTH_URL=http://localhost:8080/health
# BEZANT_LOGIN_URL=https://localhost:5000
# BEZANT_RELOGIN_STATE_DIR=~/.local/state/bezant-relogin
# BEZANT_CONTAINER=bezant   # container restarted to clear a wedged gateway
#
# Alerting (HIGHLY recommended — without it, a disabled relogin is silent).
# Slack/Discord/ntfy-compatible webhook that receives {"text": "..."}. When set,
# you get pinged if auto-relogin disables itself / the fund stays logged out.
# Set the SAME value in pi/watchdog/.env so the watchdog backstop can alert too.
# IBKR_FUND_ALERT_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ
