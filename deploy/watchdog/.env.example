# Copy to .env on the Pi and chmod 600 (optional — watchdog runs without it).
#
# Alerting (recommended): set the SAME webhook as pi/relogin/.env so the
# watchdog can ping you if the fund stays logged out while relogin is disabled.
# Slack/Discord/ntfy-compatible webhook that receives {"text": "..."}.
# IBKR_FUND_ALERT_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ
#
# Optional — defaults shown
# BEZANT_HEALTH_URL=http://localhost:8080/health
# BEZANT_CONTAINER=bezant
