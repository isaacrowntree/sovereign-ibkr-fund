# Copy to .env on the Pi and chmod 600 (optional — watchdog runs without it).
#
# Alerting (recommended): set the SAME webhook as pi/relogin/.env so the
# watchdog can ping you if the fund stays logged out while relogin is disabled.
# Slack/Discord/ntfy-compatible webhook that receives {"text": "..."}.
# IBKR_FUND_ALERT_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ
#
# Optional — defaults shown
# BEZANT_HEALTH_URL=http://localhost:8080/health
# BEZANT_CONTAINER=bezant
#
# Restart policy. dry-run logs every restart, park clear and reauthenticate it
# WOULD do, and does none of them (the stream reconnect still runs). Watch the
# journal for a while before setting `on`.
# WATCHDOG_RESTART=dry-run
#
# bezant's debug token (the container's BEZANT_DEBUG_TOKEN), needed for
# POST /events/_reconnect. Unset: that rung is skipped and a silent stream goes
# straight to /iserver/reauthenticate.
# BEZANT_DEBUG_TOKEN=
#
# Shared with relogin, preflight and the hub; bind-mounted into bezant.
# IBKR_SESSION_LOCK_DIR=~/.local/state/ibkr-session
#
# Quiet hours (D5): no restart unless the gateway is dead, no park clearing.
# QUIET_HOURS_TZ=Australia/Sydney
# QUIET_HOURS=23-7
