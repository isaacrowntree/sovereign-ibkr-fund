[Unit]
Description=Bezant container liveness watchdog (auto-restart on wedged session)
Documentation=https://github.com/isaacrowntree/ibkr-fund/tree/master/pi/watchdog
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/ibkr-fund/pi/watchdog
ExecStart=/usr/bin/env npx tsx %h/ibkr-fund/pi/watchdog/index.ts
StandardOutput=journal
StandardError=journal
# Bound the worst case: a slow docker restart + post-restart probes (~60s)
TimeoutStartSec=120

[Install]
WantedBy=default.target
