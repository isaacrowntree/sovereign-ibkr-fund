[Unit]
Description=Bezant container liveness watchdog (auto-restart on wedged session)
Documentation=https://github.com/isaacrowntree/sovereign-ibkr-fund/tree/main/deploy/watchdog
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/sovereign-ibkr-fund/deploy/watchdog
# The LEADING DASH is load-bearing: watchdog's .env is explicitly optional
# (".env.example" says it runs without one). Undashed, systemd fails the unit
# when the file is absent — taking down the very service whose job is telling
# you the fund is wedged.
#
# index.ts also does `import 'dotenv/config'` against WorkingDirectory, so this
# is belt-and-braces; it exists so the unit works the same way as relogin's
# (whose .env IS required, hence no dash there).
EnvironmentFile=%h/sovereign-ibkr-fund/deploy/watchdog/.env
ExecStart=/usr/bin/env npx tsx %h/sovereign-ibkr-fund/deploy/watchdog/index.ts
StandardOutput=journal
StandardError=journal
# Bound the worst case: a slow docker restart + post-restart probes (~60s)
TimeoutStartSec=120

[Install]
WantedBy=default.target
