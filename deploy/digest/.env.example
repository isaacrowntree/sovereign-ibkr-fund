# Copy to .env on the Pi at ~/ibkr-fund/pi/digest/.env
#
# Set the SAME webhook as the fund / pi/watchdog / pi/relogin — the digest posts
# through the same single channel as every other alert.
IBKR_FUND_ALERT_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Optional. NOTIFIER=noop silences the digest without unsetting the webhook.
# NOTIFIER=noop

# Optional. Rendered into the message footer so a paper digest is
# distinguishable from a live one at a glance. Defaults to 'paper'.
# TRADING_MODE=live
