[Unit]
Description=IBKR fund daily summary to Slack
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
# Alert webhook (same URL as the fund/watchdog/relogin — see .env.example).
EnvironmentFile=%h/sovereign-ibkr-fund/deploy/digest/.env
# Mirrors the backup unit: runs inside the paperclip container. The digest needs
# no IBKR connection, so the gateway does not have to be up.
# -e forwards the webhook/NOTIFIER/TRADING_MODE from this unit into the container.
#
# NOT "reads state only" — the digest WRITES `notify_dedupe`. That write is how
# the stale-ledger bug stayed alive: with STATE_DIR unset it defaulted to cwd
# (the old `ibkr-fund` checkout) and kept that copy warm until 2026-08-02.
# STATE_DIR is now explicit and points at the durable location outside the
# paperclip workspace (/var/lib/sovereign-fund/state -> /fund-state).
ExecStart=/usr/bin/docker exec -u node \
  -e IBKR_FUND_ALERT_WEBHOOK \
  -e NOTIFIER \
  -e TRADING_MODE \
  -e STATE_DIR=/fund-state/state \
  -w /paperclip/instances/default/projects/COMPANY_ID/PROJECT_ID/sovereign-ibkr-fund \
  paperclip node dist/agents/daily-summary.js --once
