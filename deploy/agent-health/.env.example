# Postgres URL for paperclip's schema. MUST include `extensions` in search_path.
PAPERCLIP_DATABASE_URL=postgresql://paperclip_app:PASSWORD@db.PROJECT.supabase.co:5432/postgres?options=-csearch_path%3Dpaperclip,extensions
