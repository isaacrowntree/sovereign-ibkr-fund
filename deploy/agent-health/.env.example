# Same Slack incoming webhook the fund's other alerts use. Used for ONE push:
# on an NYSE trading day, no successful Portfolio Strategist run in 24h or
# Execution Bot run in 48h. Everything else goes to the ops feed only.
IBKR_FUND_ALERT_WEBHOOK=https://hooks.slack.com/services/...

# 0 disables that push (the feed line is still written).
# AGENT_HEALTH_TRADING_PUSH=1
# The paperclip company whose agents are the fund. Agents of any other company
# (e.g. a crypto bot on the same paperclip) are reported under `others`.
# AGENT_HEALTH_FUND_COMPANY=IBKR Fund

# NOTE: no PAPERCLIP_DATABASE_URL here, on purpose.
# check.mjs still reads that variable, but the systemd unit supplies it from the
# paperclip container's own DATABASE_URL rather than from this file. A second
# copy of the URL living here is what broke this check once already: paperclip
# moved to a different database, this copy was left pointing at the retired one,
# and every run died on `relation "paperclip.agents" does not exist` — silencing
# the alarm that exists to tell you agents are dying. Keep it in one place.
# If you run check.mjs by hand, set it in your shell for that invocation.
