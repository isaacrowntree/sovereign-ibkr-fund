# Keep run blobs this many days. Row + status/error_code/timings are kept forever.
RETENTION_DAYS=90

# NOTE: no PAPERCLIP_DATABASE_URL here, on purpose — the systemd unit supplies it
# from the paperclip container's own DATABASE_URL. See deploy/agent-health/.env.example
# for why a second copy of that URL is a trap. If you run prune.mjs by hand, set
# it in your shell for that invocation.
