# Sovereign — configuration. Copy to `.env` and edit. Everything has a safe default.

# ─── bezant gateway ───────────────────────────────────────────────────────────
BEZANT_URL=http://localhost:8080         # your running bezant gateway
# IBKR_ACCOUNT_ID=                        # optional; defaults to the first account bezant returns
BEZANT_TIMEOUT_MS=30000
# Cloudflare Access service-token creds, if bezant sits behind Zero Trust (both or neither):
# BEZANT_CF_ACCESS_CLIENT_ID=
# BEZANT_CF_ACCESS_CLIENT_SECRET=

# ─── the model portfolio ──────────────────────────────────────────────────────
# Resolution order: this JSON file, then the compiled private `local.ts`, then
# the sample template. The file exists so weights can be published WITHOUT a
# build: local.ts is TypeScript, and a host that cannot run tsc cannot change a
# weight without a deploy from a workstation.
#   Format: [{ "symbol": "AAA", "name": "Alpha", "pct": 60, "sleeve": "hedge" }]
#   Sleeves: tech_growth industrials healthcare financials defensive hedge
#   Weights must sum to 100. A file that is present but invalid REFUSES to
#   trade — it never silently falls back to older weights.
# PORTFOLIO_TARGETS_FILE=/fund-state/targets.json
#
# Set this on any deployment with a real book. The sample template also sums to
# 100, so before this existed a missing or corrupt private model became the
# sample silently, and the strategist would rebalance the real book into it.
REQUIRE_PRIVATE_PORTFOLIO=false           # true on a private deployment

# ─── deploying new cash (the standing instruction) ────────────────────────────
# A deposit is approved at DECLARATION time, not trade time: you write down
# which names it is for, before it lands, and the fund executes that without
# asking. With no policy file the ordinary cash-flow path runs, unchanged.
#   { "directed": ["NET","XLE"],      names funded to target first, and exempt
#                                      from the rebuy guard — a name written
#                                      down in advance is an instruction, not
#                                      churn. Everything else still respects it.
#     "minDeployUsd": 1000,           below this, do nothing and wait
#     "reserveUsd": 150,              held back for commission and slippage
#     "expiresAt": "2026-10-01T00:00:00Z" }   REQUIRED — an instruction lapses
# Target weights are NOT in here: those are the model above, so there is no
# second copy to drift out of step. A file that is present but malformed
# refuses to trade rather than falling back to the pro-rata path.
# Gated on SETTLED cash: an unsettled deposit shows in the balance but funds
# nothing, and the executor defers such buys silently.
# DEPOSIT_POLICY_FILE=/fund-state/deposit-policy.json

# ─── trading mode ─────────────────────────────────────────────────────────────
TRADING_MODE=paper                        # paper | live   (START ON PAPER)

# ─── scheduler (built-in; set false to let paperclip/cron/systemd drive) ──────
ENABLE_SCHEDULER=true
# Per-agent cadence overrides (seconds); defaults shown:
# SCHED_CEO_SEC=14400
# SCHED_STRATEGIST_SEC=14400
# SCHED_QUANT_SEC=14400
# SCHED_RISK_SEC=14400
# SCHED_EXEC_SEC=14400
# SCHED_TAX_SEC=86400
# SCHED_HEDGER_SEC=86400
# SCHED_SCOUT_SEC=86400

# ─── rebalancing ──────────────────────────────────────────────────────────────
REBALANCE_DRIFT_THRESHOLD=10              # % portfolio drift to trigger a rebalance
REBALANCE_URGENT_DRIFT_THRESHOLD=25       # single-name drift that bypasses the cooldown
REBALANCE_MIN_TRADE_USD=50
REBALANCE_FREQ_DAYS=45
REBALANCE_CASH_BUFFER_PCT=1.0
REBALANCE_FILL_MODE=greedy                # greedy | proportional (full rebalances)

# How a DEPOSIT is spread across underweights (allocateCashFlow), separate from
# REBALANCE_FILL_MODE above. 'proportional' is the historical default but
# strands cash: a pro-rata slice smaller than one share floors to zero, so a
# balance spread across expensive names deploys nothing at all, every cycle,
# indefinitely. 'greedy' fills the largest deficit a share at a time and still
# refuses to overshoot a target.
REBALANCE_CASHFLOW_FILL_MODE=proportional # greedy | proportional
# Cash the cash-flow path never deploys. Set ONE: the base-currency figure is
# converted at the ledger's USD rate each run and wins when a rate exists.
# CASH_FLOW_RESERVE_BASE=500   # in the account's base currency (e.g. AUD)
# CASH_FLOW_RESERVE_USD=1000   # fallback, in USD

# ─── execution caps (hard backstops) ──────────────────────────────────────────
EXECUTION_CASH_HEADROOM_PCT=2
MAX_ORDER_NOTIONAL_USD=15000
MAX_ORDER_PCT_NAV=50
MAX_RUN_NOTIONAL_USD=60000

# ─── market-data sanity gates ─────────────────────────────────────────────────
MIN_NAV_USD=1000
MAX_NAV_MOVE_PCT=35
MAX_PRICE_MOVE_PCT=30

# ─── risk ─────────────────────────────────────────────────────────────────────
TARGET_VOL=0.20
MAX_LEVERAGE=1.0
DD_WARNING=7
DD_DERISK=15
DD_HARD_STOP=25

# ─── strategy ─────────────────────────────────────────────────────────────────
# REQUIRED with TRADING_MODE=live — the strategist refuses to start without it.
# static = hold the model's own weights (the default, and the safe one).
OPTIMIZER=static                          # static | hrp | black_litterman | equal_weight
ENABLE_REGIME=false                       # opt-in: only `true` enables the regime overlay

# ─── state (keep OUTSIDE the checkout so code + state never entangle) ─────────
# STATE_DIR=~/.sovereign/state

# ─── notifications (best-effort; never blocks trading) ────────────────────────
# One webhook, one channel. Severity is carried by colour + emoji, not routing.
# With TRADING_MODE=live the daemon REFUSES TO START unless one of these is set:
# an unset webhook silently degrades every alert — including the drawdown hard
# stop — to /dev/null, so silence has to be a deliberate choice.
# NOTIFIER=webhook                        # webhook | noop  (auto: webhook if URL set, else noop)
# IBKR_FUND_ALERT_WEBHOOK=                # Slack-compatible incoming webhook
# A structured alert that fails to reach Slack is queued in the ledger and
# retried by the observer every 5 minutes (for up to 24h), instead of waiting
# for the same agent to run again. 0 = the older release-and-retry behaviour.
# NOTIFY_OUTBOX=0                         # 0 | 1

# ─── scheduling (built-in scheduler only; ignored when ENABLE_SCHEDULER=false) ─
# SCHED_OBSERVER_SEC=300                  # event-stream poll; gaps are unrecoverable, so keep it tight
# SCHED_DIGEST_SEC=86400                  # daily summary; deploy/digest/ has the market-close-anchored timer

# ─── ops alerting ─────────────────────────────────────────────────────────────
# OBSERVER_BLIP_MINUTES=10    # an event-stream outage shorter than this is recorded, not paged;
#                             # a second outage within 24h pages at once. 0 = page on first sight
# RECONCILE_STALE_HOURS=14    # observer pushes when no reconcile has completed for this long. 0 = off
# RECONCILE_AUTH_RETRY_MIN=1,2,4,8,15   # reconciler's waits for a logged-out gateway before deferring
# RECONCILE_DRIFT_REF=baseline          # ledger drift vs the accepted baseline; `last` = old compare-to-last-run
# DIGEST_STALE_HOURS=26       # digest marks its snapshot STALE (and pushes) past this age. 0 = off

# ─── risk gate ────────────────────────────────────────────────────────────────
# Max age of the risk-manager's drawdown level before execution refuses to trade
# ungated. Default 5h.
#
# Tune this to your ACTUAL risk-manager cadence C (whatever your orchestrator
# uses — under an external scheduler it is NOT the SCHED_*_SEC values):
#   > C   one missed risk run still trades, on the previous cycle's level  ← default
#   ~C/2  a single missed run blocks (tighter, recommended once C is known)
#   << C  blocks NORMAL operation — the fund stops trading entirely
# Getting this wrong is asymmetric: too loose trades one stale round, too tight
# halts the fund. See src/execution/risk-gate.ts.
# RISK_STALE_HOURS=5

# ─── execution kill switches ──────────────────────────────────────────────────
# EXECUTION_ENABLED=1                     # 0 stops placement (also: state executionEnabled=false)
# RUN_BUDGET_SEC=240                      # stop placing when the fill wait won't fit; 0 = off
# RUN_LEASE_SEC=120                       # run-lock lease; a dead run frees it within this
# REPLY_POLICY=log                        # log | enforce — which order prompts get confirmed
# REPLY_ALLOW_IDS=                        # extra prompt ids to allow under enforce (comma-separated)
# INACTIVE_WORKING_HOURS=6                # an Inactive order blocks duplicates this long; 0 = never
# STAGED_ORDER_TTL_TRADING_HOURS=13       # staged orders expire after this much trading time; 0 = off
# CALENDAR_FAIL_OPEN=1                    # past the NYSE table's end: 1 trade weekdays, 0 stay closed

# ─── misc ─────────────────────────────────────────────────────────────────────
PORT=3001                                 # status server
